# Copy to .env and fill in. .env is gitignored.

# Browser (inlined at build time). Leave the RiverX pair empty: the dev DB proxy sets it in `pnpm dev`.
VITE_APP_NAME=
# Leave empty: defaults to /__local-api in dev (RiverX routes /api/* to itself), /api in production.
VITE_API_BASE_URL=
VITE_RIVERX_DB_URL=
VITE_RIVERX_DB_KEY=

# Server only. Never prefix these with VITE_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Invite code for admins after the first one. Unset: signup closes after the first admin.
ADMIN_SIGNUP_CODE=
# Public origin for links in emails, e.g. https://book.example.com
APP_URL=
# Booking confirmation emails via Resend. Unset: emails are logged on the server.
RESEND_API_KEY=
EMAIL_FROM=
